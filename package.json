{
  "name": "pi-aws-knowledge",
  "version": "0.1.0",
  "description": "A Pi extension for searching and retrieving official AWS documentation",
  "type": "module",
  "files": [
    "src",
    "img"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/senad-d/pi-aws-knowledge.git"
  },
  "homepage": "https://github.com/senad-d/pi-aws-knowledge#readme",
  "bugs": {
    "url": "https://github.com/senad-d/pi-aws-knowledge/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "check": "npm run typecheck && npm test && npm run lint && npm run format:check && npm run smoke",
    "prepublishOnly": "npm run release:check",
    "release:check": "node -e \"const p=require('./package.json'); if(p.private || p.publishConfig?.access !== 'public' || !p.keywords?.includes('pi-package') || !p.pi?.extensions?.length) throw new Error('package is not configured as a public Pi package')\" && npm run check && npm pack --dry-run",
    "format": "biome format --write src tests package.json tsconfig.json biome.json eslint.config.js",
    "format:check": "biome format src tests package.json tsconfig.json biome.json eslint.config.js",
    "lint": "eslint src tests",
    "smoke": "pi --no-extensions -e . --list-models",
    "test": "node --test tests/index.test.ts",
    "test:coverage": "mkdir -p coverage && node --test --experimental-test-coverage --test-coverage-include='src/**/*.ts' --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info tests/index.test.ts",
    "test:live": "node --test tests/live.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "aws",
    "aws-documentation"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/senad-d/pi-aws-knowledge/main/img/icon.png"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@eslint/js": "10.0.1",
    "@types/node": "22.19.19",
    "eslint": "10.9.1",
    "globals": "17.12.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0"
  }
}
