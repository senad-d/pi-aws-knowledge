{
  "name": "pi-aws-knowledge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "check": "npm run typecheck && npm test && npm run lint && npm run format:check && npm run smoke",
    "format": "biome format --write src tests package.json tsconfig.json biome.json eslint.config.js",
    "format:check": "biome format src tests package.json tsconfig.json biome.json eslint.config.js",
    "lint": "eslint src tests",
    "smoke": "pi --no-extensions -e . --list-models",
    "test": "node --test tests/index.test.ts",
    "test:coverage": "mkdir -p coverage && node --test --experimental-test-coverage --test-coverage-include='src/**/*.ts' --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info tests/index.test.ts",
    "test:live": "node --test tests/live.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@eslint/js": "10.0.1",
    "@types/node": "22.19.19",
    "eslint": "10.9.1",
    "globals": "17.12.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0"
  }
}
